{
  "name": "trading-platform",
  "version": "1.0.0",
  "description": "Production-grade algorithmic trading platform",
  "author": "",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "lint": "eslint \"{src,tests}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,tests}/**/*.ts\" --max-warnings 0",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:cov": "cross-env NODE_ENV=test jest --coverage",
    "test:ci": "cross-env NODE_ENV=test jest --coverage --ci --forceExit --passWithNoTests",
    "test:unit": "cross-env NODE_ENV=test jest --testPathPattern=tests/unit",
    "test:unit:ci": "cross-env NODE_ENV=test jest --testPathPattern=tests/unit --coverage --ci --forceExit",
    "test:integration": "cross-env NODE_ENV=test jest --testPathPattern=tests/integration",
    "test:integration:ci": "cross-env NODE_ENV=test jest --testPathPattern=tests/integration --ci --forceExit",
    "test:e2e": "cross-env NODE_ENV=test jest --config ./jest-e2e.config.ts --forceExit",
    "test:infra": "cross-env NODE_ENV=test jest --config jest-integration-live.config.ts --forceExit",
    "test:infra:ci": "cross-env NODE_ENV=test jest --config jest-integration-live.config.ts --forceExit --ci",
    "test:infra:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:infra:down": "docker compose -f docker-compose.test.yml down -v",
    "test:e2e:paper": "cross-env NODE_ENV=test jest --config ./jest-e2e.config.ts --testPathPattern=tests/e2e/paper-trading --forceExit",
    "test:e2e:testnet": "cross-env NODE_ENV=test BINANCE_SPOT_TESTNET=true jest --config ./jest-e2e.config.ts --testPathPattern=tests/e2e/exchange/binance-testnet --forceExit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cross-env": "^7.0.3",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "joi": "^17.13.3",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.1",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2"
  }
}
