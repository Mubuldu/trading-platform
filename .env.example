# =============================================================================
# Trading Platform — Environment Variables Reference
#
# Copy this file to .env.<environment> and fill in real values.
# NEVER commit .env files with real secrets to version control.
#
# Secret management:
#   SECRETS_PROVIDER=env    → values come from this file (dev / CI)
#   SECRETS_PROVIDER=docker → values come from Docker secrets (/run/secrets/*)
#   SECRETS_PROVIDER=vault  → Vault integration (prepared, not yet implemented)
#
# Namespace documentation matches src/config/ registerAs() factories.
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=trading-platform
APP_PORT=3000
APP_VERSION=1.0.0

# Swagger UI (disable in production)
SWAGGER_ENABLED=true

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Internal API key (used for health check auth and admin endpoints)
# Generate: openssl rand -base64 48
API_KEY_SECRET=CHANGE_ME_generate_with_openssl_rand

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
# LOG_LEVEL options: error | warn | info | http | verbose | debug | silly

LOG_DIR=/app/logs
LOG_MAX_FILE_SIZE_MB=20
LOG_MAX_FILES=14
LOG_ERROR_MAX_FILES=30
LOG_ENABLE_CONSOLE=true
LOG_JSON_OUTPUT=false
# Set LOG_JSON_OUTPUT=true in production for structured log ingestion

# ─── Database (PostgreSQL via Kysely) ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_platform
DB_USER=trading
DB_PASSWORD=CHANGE_ME_set_strong_password
DB_SSL=false
# Set DB_SSL=true in production; provide DB_SSL_CA if using custom CA

DB_POOL_MIN=2
DB_POOL_MAX=10

# Run Kysely migrations automatically on startup
DB_MIGRATE_ON_STARTUP=true

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# For authenticated Redis: redis://:password@host:6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=tp:
REDIS_STREAM_MAXLEN=100000

# ─── Secrets Provider ─────────────────────────────────────────────────────────
SECRETS_PROVIDER=env
# Options: env | docker
# Vault provider is prepared — set SECRETS_PROVIDER=vault and configure
# VAULT_ADDR + VAULT_TOKEN when the Vault integration is implemented.
DOCKER_SECRETS_PATH=/run/secrets

# ─── Exchange ─────────────────────────────────────────────────────────────────
DEFAULT_EXCHANGE_ID=binance-spot
MARKET_DATA_CACHE_TTL_MS=5000
ORDER_BOOK_DEPTH=10
TICKER_CACHE_TTL_MS=2000
# Comma-separated list of exchange IDs to enable
ENABLED_EXCHANGES=binance-spot

# ─── Binance Spot Adapter ─────────────────────────────────────────────────────
# Leave empty to use public endpoints only (market data, no trading)
BINANCE_SPOT_API_KEY=
BINANCE_SPOT_SECRET_KEY=

BINANCE_SPOT_BASE_URL=https://api.binance.com
BINANCE_SPOT_TESTNET=false
# Set BINANCE_SPOT_TESTNET=true for testnet: https://testnet.binance.vision
BINANCE_SPOT_TIMEOUT_MS=10000
BINANCE_SPOT_RECV_WINDOW_MS=5000
BINANCE_SPOT_MAX_RETRIES=3
BINANCE_SPOT_POOL_SIZE=10

# ─── Risk Management ──────────────────────────────────────────────────────────
RISK_ENABLED=true
MAX_POSITION_SIZE_USD=10000
MAX_DRAWDOWN_PERCENT=10
MAX_DAILY_LOSS_USD=1000
MAX_ORDER_SIZE_USD=5000
MAX_LEVERAGE=3
MAX_OPEN_ORDERS=10
MAX_CONCENTRATION_PERCENT=25

# ─── Strategy ─────────────────────────────────────────────────────────────────
# Comma-separated list of strategy IDs to load at startup
ENABLED_STRATEGY_IDS=example-strategy
DEFAULT_SYMBOL=BTC/USDT
MAX_CONCURRENT_STRATEGIES=5
STRATEGY_HEARTBEAT_INTERVAL_MS=5000
ORDER_COOLDOWN_MS=1000

# ─── Execution ────────────────────────────────────────────────────────────────
ORDER_ROUTING_MODE=direct
# ORDER_ROUTING_MODE options: direct | smart | paper
SLIPPAGE_TOLERANCE_BPS=10
MAX_SLIPPAGE_BPS=50
RETRY_ON_PARTIAL_FILL=true
MAX_RETRIES=3
ORDER_TIMEOUT_MS=30000
CANCEL_ON_TIMEOUT=true

# ─── Paper Trading ────────────────────────────────────────────────────────────
PAPER_TRADING_ENABLED=true
PAPER_TRADING_INITIAL_BALANCE_USD=10000
SIMULATE_SLIPPAGE=true
SIMULATE_LATENCY=true
LATENCY_MS=50
SLIPPAGE_BPS=5
RESET_ON_RESTART=false

# ─── ML Signal Sidecar (Level 3) ─────────────────────────────────────────────
# URL of the Python FastAPI sidecar that scores candidate trade signals.
# Leave empty to disable — TrendFollowingV1Strategy falls through to pass-through
# mode and every signal is accepted (identical behaviour to running without ML).
#
# In Docker Compose:  http://ml-service:8001
# Local dev (no Docker):  http://localhost:8001
# Unset / empty:  ML scoring disabled — backtest/optimisation unaffected.
ML_SERVICE_URL=

# ─── Backtesting ──────────────────────────────────────────────────────────────
BACKTESTING_DATA_DIR=./data/backtesting
BACKTESTING_RESULTS_DIR=./data/results
DEFAULT_COMMISSION_BPS=10
DEFAULT_SLIPPAGE_BPS=5
DEFAULT_INITIAL_CAPITAL_USD=10000
MAX_WORKERS=4

# ─── Monitoring ───────────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PREFIX=trading_platform
METRICS_INTERVAL_MS=15000
THRESHOLD_LATENCY_MS=500
THRESHOLD_ERROR_RATE=0.05
THRESHOLD_MEMORY_MB=400
THRESHOLD_CPU_PERCENT=80

# ─── Alerts ───────────────────────────────────────────────────────────────────
ALERTS_ENABLED=true
ALERTS_COOLDOWN_SECONDS=300
ALERT_PRICE_DEVIATION_PERCENT=5
ALERT_LATENCY_MS=1000
ALERT_ERROR_RATE=0.1
ALERT_DRAWDOWN_PERCENT=5
ALERT_POSITION_UTILIZATION_PERCENT=90
ALERT_FILL_RATE_PERCENT=50

# ─── Horizontal Scaling (Milestone 33) ──────────────────────────────────────
# Set CLUSTER_ENABLED=true to activate Redis-backed lock/cache/queue providers
# and enable worker registration, leader election, and task routing.
# All variables below have safe defaults for single-node deployments.

# Master switch. false = single-node in-memory mode (default).
CLUSTER_ENABLED=false

# Stable unique identifier for this node. Defaults to hostname:PID if unset.
# In Kubernetes, set to: $(POD_NAME) via fieldRef metadata.name.
CLUSTER_NODE_ID=

# Optional human-readable label shown in dashboards.
CLUSTER_NODE_LABEL=

# Comma-separated capabilities this node advertises to the task router.
# Values: indicator, strategy, risk, execution, analytics, backtest, paper_trading, api
CLUSTER_WORKER_CAPABILITIES=indicator,strategy,risk,execution,analytics,backtest

# ── Heartbeat ────────────────────────────────────────────────────────────────
# How often (ms) this node publishes its liveness key to Redis.
CLUSTER_HEARTBEAT_INTERVAL_MS=3000

# TTL (ms) of the heartbeat key in Redis. Must be > CLUSTER_HEARTBEAT_INTERVAL_MS.
# Recommended: 3× the interval. Setting too close to interval causes false positives.
CLUSTER_HEARTBEAT_TTL_MS=10000

# How often (ms) the cluster leader scans for and removes dead workers.
CLUSTER_DEAD_WORKER_CHECK_INTERVAL_MS=5000

# ── Leader Election ──────────────────────────────────────────────────────────
# TTL (ms) of the leader lease key. Max time followers wait for a new leader
# after the current leader crashes without releasing.
CLUSTER_LEADER_LEASE_TTL_MS=30000

# How often (ms) the current leader renews its lease. Must be < CLUSTER_LEADER_LEASE_TTL_MS.
CLUSTER_LEADER_RENEWAL_INTERVAL_MS=10000

# ── Task Distribution ────────────────────────────────────────────────────────
# Default balancing strategy for task types not covered by the static routing
# table. Values: round-robin | least-loaded | sticky | weighted
CLUSTER_TASK_DISTRIBUTION_STRATEGY=round-robin

# ── Metrics ──────────────────────────────────────────────────────────────────
# How often (ms) each node publishes resource metrics (CPU, memory, tasks) to Redis.
CLUSTER_METRICS_PUBLISH_INTERVAL_MS=5000

# TTL (ms) of published metrics. Should be several multiples of the publish interval.
CLUSTER_METRICS_TTL_MS=30000

# ── Distributed Locking ──────────────────────────────────────────────────────
# Default lock TTL (ms) when the caller does not specify one.
CLUSTER_DEFAULT_LOCK_TTL_MS=30000

# Maximum time (ms) to wait for a lock before returning LockAcquisitionError.
CLUSTER_LOCK_WAIT_MS=5000

# Base retry interval (ms) between lock acquisition attempts.
CLUSTER_LOCK_RETRY_INTERVAL_MS=50

# Random jitter (ms) added to the retry interval to prevent thundering herd.
CLUSTER_LOCK_RETRY_JITTER_MS=25
